# ==========================================
# LiteApp Studio - 环境变量配置文件示例
# ==========================================

# 管理员鉴权密码 (用于进入工作台、上传覆盖应用与修改模型设置)
ADMIN_PASSWORD=admin888

# 数据持久化目录 (容器内默认 /app/data，本地开发默认 ./data)
DATA_DIR=/app/data

# 默认 OpenAI 兼容接口配置 (首次启动若无提供商自动初始化)
DEFAULT_OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_OPENAI_API_KEY=sk-your-openai-api-key-here
DEFAULT_OPENAI_MODEL=gpt-4o

# 单个 ZIP 上传解压最大限制 (MB)
MAX_UPLOAD_SIZE_MB=50

# 服务运行端口
PORT=8000
HOST=0.0.0.0
